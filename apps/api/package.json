{
  "name": "@center/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "start": "node dist/main.js",
    "start:sync": "node dist/sync/sync-worker-main.js",
    "start:whatsapp": "node dist/whatsapp/worker-main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "dev:sync": "node --watch --experimental-strip-types src/sync/sync-worker-main.ts",
    "dev:whatsapp": "node --watch --experimental-strip-types src/whatsapp/worker-main.ts",
    "eval:agent": "node --experimental-strip-types scripts/eval-agent.ts",
    "warm:cache": "node --experimental-strip-types scripts/warm-cache.ts",
    "health:report": "node --experimental-strip-types scripts/health-report.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@center/mcp-core": "workspace:*",
    "@center/pii": "workspace:*",
    "@center/secrets": "workspace:^",
    "@center/shared": "workspace:*",
    "@center/uappi-client": "workspace:^",
    "@center/uappi-sync": "workspace:^",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.1.0",
    "ai": "^5.0.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  }
}
